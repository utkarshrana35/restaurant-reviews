# Copy to .env and adjust. Every value shown uncommented is also the built-in default,
# so the backend starts without a .env file against a local MongoDB.

NODE_ENV=development
PORT=4000

# 127.0.0.1 rather than localhost: Node may resolve localhost to IPv6 (::1),
# which a default mongod does not listen on.
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_reviews

# Signs access tokens and keys verification-code hashes. At least 32 characters.
# A development-only value is used when unset; production refuses to start without its own.
# JWT_SECRET=

# Password hashing cost.
BCRYPT_ROUNDS=12

# Lifetime of an access token (1 to 60). Kept short because an issued access token cannot be
# revoked; the frontend renews it automatically with the refresh token.
ACCESS_TOKEN_TTL_MINUTES=15

# Lifetime of a refresh token: how long a user stays signed in on a device (1 to 30).
REFRESH_TOKEN_TTL_DAYS=7

# Browser origins allowed to make state-changing requests, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Outgoing email: console | smtp | ses.
# console prints each email (including verification codes) to the backend log and sends nothing.
# Production refuses to start with console.
EMAIL_PROVIDER=console
# EMAIL_FROM=Restaurant Reviews <no-reply@example.com>

# When EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# Credentials, for servers that require signing in: set both or neither.
# SMTP_USER=
# SMTP_PASS=

# When EMAIL_PROVIDER=ses. EMAIL_FROM must be an address or domain verified in SES.
# Credentials are not set here: the AWS SDK reads them from its default chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, shared config, or an attached IAM role).
# AWS_REGION=

# Image storage. Outside production, everything unset points at LocalStack, which
# `pnpm infra:up` starts (http://127.0.0.1:4566, credentials test/test).
# In production, leave S3_ENDPOINT and the S3 credentials unset to use AWS itself with the
# SDK's default credential chain (for example an attached IAM role).
# S3_BUCKET=restaurant-reviews
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Address images are loaded from: the CDN. Outside production it defaults to the local CDN
# container (http://127.0.0.1:4567/<bucket>). Required in production: the CloudFront address.
# IMAGE_BASE_URL=https://d111111abcdef8.cloudfront.net

# --- Not read by the API ------------------------------------------------------------------------
# Used only by `pnpm storage:setup`, and required when it targets AWS: the image distribution
# allowed to read the bucket; the bucket is then closed to everyone else. Left unset against
# LocalStack, where the local CDN container reads the bucket. Never needed by a running API.
# CLOUDFRONT_DISTRIBUTION_ARN=arn:aws:cloudfront::123456789012:distribution/EDFDVBD6EXAMPLE
