{
  "name": "@restaurant-reviews/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "job:delete-orphaned-reviews": "node --env-file-if-exists=.env dist/delete-orphaned-reviews.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storage:setup": "tsx --env-file-if-exists=.env scripts/storage/setupStorage.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "seed": "tsx --env-file-if-exists=.env scripts/seed/seed.ts",
    "reviews:delete-orphans": "tsx --env-file-if-exists=.env scripts/orphanedReviews/deleteOrphanedReviews.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/client-sesv2": "^3.1150.0",
    "@aws-sdk/s3-presigned-post": "^3.1150.0",
    "@restaurant-reviews/common": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "nodemailer": "^10.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "esbuild": "catalog:",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
